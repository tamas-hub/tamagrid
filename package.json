{
  "name": "tamagrid",
  "private": true,
  "version": "0.7.0",
  "description": "Local-first multi-task desktop workspace for Codex App Server",
  "author": "TamaGrid contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamas-hub/tamagrid.git"
  },
  "homepage": "https://github.com/tamas-hub/tamagrid#readme",
  "bugs": {
    "url": "https://github.com/tamas-hub/tamagrid/issues"
  },
  "keywords": [
    "codex",
    "codex-app-server",
    "tauri",
    "desktop-app",
    "developer-tools"
  ],
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "check:commit-emails": "node scripts/check-commit-emails.mjs",
    "check:app-server-schema": "node scripts/check-app-server-schema.mjs",
    "test:packaged-soak": "node scripts/run-packaged-soak.mjs",
    "install:privacy-hook": "node scripts/install-privacy-hook.mjs",
    "check": "pnpm lint && pnpm test:run && pnpm build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "@tauri-apps/cli": "^2"
  }
}
