{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TamaGrid",
  "version": "0.7.0",
  "identifier": "io.github.tamas-hub.tamagrid",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TamaGrid — Multi-task workspace for Codex",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Multi-task desktop workspace for Codex App Server",
    "longDescription": "Run and supervise up to four local Codex App Server threads in one desktop workspace.",
    "homepage": "https://github.com/tamas-hub/tamagrid",
    "publisher": "TamaGrid contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
